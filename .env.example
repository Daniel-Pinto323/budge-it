# Copy to .env and fill in. Never commit .env. Real environment variables override this file.

# --- Required ---------------------------------------------------------------
# Encrypts stored Plaid access tokens. Generate with: python3 server.py generate-key
# Back it up somewhere separate from the database: without it every bank must be relinked.
BUDGEIT_ENCRYPTION_KEY=

# --- Server -----------------------------------------------------------------
# Keep HOST on loopback and put a TLS reverse proxy or tunnel in front (see README).
HOST=127.0.0.1
PORT=8080
# The address you type into the browser. An https:// URL turns on Secure cookies,
# HSTS and Plaid webhooks.
PUBLIC_URL=http://localhost:8080
# Set to 1 only when a reverse proxy or tunnel on this machine forwards requests,
# so login rate limiting sees the real client address.
TRUST_PROXY=0
# Where the SQLite database lives. Defaults to ./data
#DATA_DIR=/var/lib/budgeit
# Background re-sync interval in minutes (minimum 15).
SYNC_INTERVAL_MINUTES=360

# --- Plaid ------------------------------------------------------------------
# Keys from the Plaid Dashboard. Start with sandbox; switch to production once approved.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Needed for OAuth banks (Chase, Capital One) on phones. Must be https, must match
# an Allowed redirect URI in the Plaid Dashboard exactly. Use PUBLIC_URL plus "/".
#PLAID_REDIRECT_URI=https://budget.example.com/

# --- MX ---------------------------------------------------------------------
# Client ID and API key from the MX dashboard.
# https://int-api.mx.com is the test environment; https://api.mx.com is production.
MX_CLIENT_ID=
MX_API_KEY=
MX_BASE_URL=https://int-api.mx.com
# Optional: credentials MX sends (HTTP Basic) to https://<PUBLIC_URL>/api/webhooks/mx.
# The webhook endpoint stays disabled until both are set.
#MX_WEBHOOK_USERNAME=
#MX_WEBHOOK_PASSWORD=

# --- Optional first-user bootstrap -------------------------------------------
# Creates the first login on startup if no users exist. Prefer the CLI:
#   python3 server.py create-user you@example.com
#BUDGEIT_ADMIN_EMAIL=
#BUDGEIT_ADMIN_PASSWORD=
